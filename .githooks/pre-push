#!/usr/bin/env bash
# Enabled with: git config core.hooksPath .githooks
# Refuses to push history-backup. On a push of main, recommends a version bump
# (scripts/release-check.sh) and offers to release: bump, tag, push and create the
# GitHub release. Skip with JUNK_NO_RELEASE_CHECK=1 or `git push --no-verify`.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1

pushes_main=0
while read -r local_ref _ remote_ref _; do
  case "$local_ref $remote_ref" in
    *history-backup*) echo "pre-push: history-backup must never be pushed" >&2; exit 1 ;;
  esac
  [ "$remote_ref" = refs/heads/main ] && pushes_main=1
done

[ "$pushes_main" = 1 ] && [ -z "${JUNK_NO_RELEASE_CHECK:-}" ] || exit 0

mapfile -t check < <(scripts/release-check.sh HEAD)
level=${check[0]:-none}
[ "$level" = none ] && exit 0

echo "pre-push: commits since the last release suggest a $level bump:" >&2
printf '  %s\n' "${check[@]:1}" >&2
if ! { exec 3<>/dev/tty; } 2>/dev/null; then
  echo "pre-push: no terminal; pushing without a release" >&2
  exit 0
fi

printf 'Release? [r]elease %s / [p]atch / [m]inor / [M]ajor / [s]kip, push without one / [a]bort: ' "$level" >&3
read -r answer <&3
case $answer in
  r | R | "") choice=$level ;;
  p) choice=patch ;;
  m) choice=minor ;;
  M) choice=major ;;
  s) exit 0 ;;
  *) echo "pre-push: aborted" >&2; exit 1 ;;
esac

notes=$(mktemp --suffix=.md)
tag=$(scripts/release.sh "$choice" "$notes") || exit 1
${GIT_EDITOR:-${VISUAL:-${EDITOR:-vi}}} "$notes" <&3 >&3 2>&3

printf 'Push main and %s, then publish the release? [y/N] ' "$tag" >&3
read -r answer <&3
if [ "$answer" != y ]; then
  echo "pre-push: $tag is committed and tagged locally; nothing pushed. Notes: $notes" >&2
  exit 1
fi
JUNK_NO_RELEASE_CHECK=1 git push origin main "$tag" &&
  gh release create "$tag" -R DisposableSoftware/junk-drawer --title "Junk Drawer ${tag#v}" -F "$notes" ||
  { echo "pre-push: release failed; notes are in $notes" >&2; exit 1; }
rm -f "$notes"
# The original push named the commit before the bump, which is already pushed now.
echo "pre-push: released $tag. Git reports this push as failed because the hook pushed instead." >&2
exit 1
