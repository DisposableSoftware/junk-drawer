[Desktop Entry]
Type=Application
Name=Junk Drawer
GenericName=File Manager
Comment=Minimal file manager
Keywords=files;folder;directory;explorer;browser;manager;
Exec=junk %U
Icon=io.github.DisposableSoftware.JunkDrawer
StartupWMClass=io.github.DisposableSoftware.JunkDrawer
Terminal=false
StartupNotify=true
Categories=GTK;System;FileTools;FileManager;
MimeType=inode/directory;
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=junk
